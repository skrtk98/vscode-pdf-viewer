{
  "name": "mupdf-viewer",
  "displayName": "MuPDF Viewer",
  "description": "PDF viewer that auto-reloads when your LaTeX or Typst output changes, with mouse-centered zoom, search, and outline navigation. Powered by MuPDF.",
  "version": "1.0.2",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "pdf",
    "pdf viewer",
    "pdf reader",
    "pdf preview",
    "viewer",
    "preview",
    "mupdf",
    "latex",
    "tex",
    "typst",
    "paper",
    "document",
    "auto reload",
    "remote ssh",
    "zoom"
  ],
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "PDFs can be viewed in Restricted Mode. The pdfViewer.renderResolution setting is read only from user settings until the workspace is trusted.",
      "restrictedConfigurations": [
        "pdfViewer.renderResolution"
      ]
    },
    "virtualWorkspaces": true
  },
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "pdfViewer.pdfEditor",
        "displayName": "MuPDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "MuPDF Viewer",
      "properties": {
        "pdfViewer.defaultZoom": {
          "type": "number",
          "default": 1,
          "minimum": 0.1,
          "maximum": 16,
          "markdownDescription": "Zoom level used when a PDF is first opened. `1.0` is 100%; values are limited to 0.1–16."
        },
        "pdfViewer.renderResolution": {
          "type": "number",
          "default": 96,
          "minimum": 48,
          "maximum": 384,
          "markdownDescription": "Rendering resolution in DPI, before display scaling. Higher values are sharper but use more memory; values are limited to 48–384."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "mupdf": "^1.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "1.3.0",
    "typescript": "^5.3.0",
    "vitest": "^5.0.5"
  },
  "license": "AGPL-3.0",
  "publisher": "skrtk98",
  "repository": {
    "type": "git",
    "url": "https://github.com/skrtk98/vscode-pdf-viewer.git"
  },
  "homepage": "https://github.com/skrtk98/vscode-pdf-viewer",
  "bugs": {
    "url": "https://github.com/skrtk98/vscode-pdf-viewer/issues"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  }
}
