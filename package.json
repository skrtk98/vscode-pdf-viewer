{
  "name": "mupdf-viewer",
  "displayName": "MuPDF Viewer",
  "description": "MuPDF/WASM PDF viewer for VS Code with mouse-centered zoom, search, navigation, and auto-reload.",
  "version": "0.0.7",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "pdf",
    "pdf viewer",
    "pdf preview",
    "viewer",
    "preview",
    "mupdf",
    "wasm",
    "webassembly",
    "document",
    "latex",
    "typst",
    "auto reload",
    "continuous scroll",
    "zoom"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "pdfViewer.pdfEditor",
        "displayName": "MuPDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "MuPDF Viewer",
      "properties": {
        "pdfViewer.defaultZoom": {
          "type": "number",
          "default": 1,
          "description": "Default zoom level for PDF view"
        },
        "pdfViewer.renderResolution": {
          "type": "number",
          "default": 96,
          "description": "Rendering resolution in DPI"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "mupdf": "^1.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.24.0",
    "ovsx": "1.1.1",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "license": "AGPL-3.0",
  "publisher": "skrtk98",
  "repository": {
    "type": "git",
    "url": "https://github.com/skrtk98/vscode-pdf-viewer.git"
  },
  "homepage": "https://github.com/skrtk98/vscode-pdf-viewer",
  "bugs": {
    "url": "https://github.com/skrtk98/vscode-pdf-viewer/issues"
  }
}
